# Copy to .env and adjust. Never commit .env.

# Local infrastructure (docker compose)
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DSN=postgresql://advance_rag:change-me-local-only@localhost:5432/advance_rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Azure OpenAI - leave AZURE_OPENAI_ENDPOINT empty to run with the offline mock LLM.
# Leave AZURE_OPENAI_API_KEY empty to use Entra ID (az login / managed identity).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIM=1024

# Engine tuning
ROUTER_SINGLE_THRESHOLD=0.85
ROUTER_PARALLEL_THRESHOLD=0.60
GROUNDEDNESS_THRESHOLD=0.80
SEMANTIC_CACHE_THRESHOLD=0.95
SEED_SAMPLE_DOCS=true

# Scalability
MAX_INFLIGHT_REQUESTS=100
RATE_LIMIT_CAPACITY=30
RATE_LIMIT_REFILL_PER_SEC=0.5
# Local dev runs ingestion inside the API; docker compose runs separate worker replicas.
RUN_EMBEDDED_WORKER=true
WORKER_CONCURRENCY=4

# Observability
JSON_LOGS=true
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# Set to http://jaeger:4318 when running the compose observability profile (http://localhost:4318 for local dev).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: export traces to Azure Monitor / Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
